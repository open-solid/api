{
    "name": "open-solid/api",
    "type": "symfony-bundle",
    "license": "MIT",
    "description": "An OpenApi Bridge for Symfony",
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.4",
        "doctrine/collections": "^3.0",
        "symfony/console": "^8.0",
        "symfony/framework-bundle": "^6.4|^7.4|^8.0",
        "zircote/swagger-php": "^6.0"
    },
    "require-dev": {
        "open-solid/callable-invoker": "^0.2.1",
        "open-solid/core": "^0.2.8",
        "phpunit/phpunit": "^13.0",
        "symfony/json-streamer": "^8.0"
    },
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "OpenSolid\\Api\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenSolid\\Api\\Tests\\": "tests/"
        }
    }
}
